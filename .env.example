# ==============================================================
# Maya Spirulina (اسپیرولینا مایا) — environment configuration
# Copy to .env and fill in. Never commit the real .env file.
# ==============================================================

# ---------- Application ----------
NODE_ENV=development
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="اسپیرولینا مایا | Maya Spirulina"

# ---------- PostgreSQL (Prisma) ----------
POSTGRES_USER=maya_admin
POSTGRES_PASSWORD=change-me
POSTGRES_DB=maya_spirulina_db
POSTGRES_PORT=5432
DATABASE_URL="postgresql://maya_admin:change-me@localhost:5432/maya_spirulina_db?schema=public"

# ---------- Redis (OTP, rate limit, Telegram link tokens) ----------
# Without Redis the app falls back to in-memory storage (single instance only).
REDIS_PORT=6379
REDIS_URL="redis://localhost:6379"

# ---------- Sessions ----------
# Required in production, at least 32 random characters: openssl rand -base64 48
JWT_SECRET=

# ---------- First super admin ----------
# `npm run db:seed` gives this phone number the super_admin role.
SUPER_ADMIN_PHONE=09120000000

# ---------- SMS (OTP and notifications) ----------
# "smsir" | "kavenegar" | "farazsms" | "mock". In production a provider
# without credentials reports a failure instead of pretending to send.
SMS_PROVIDER="mock"
SMSIR_API_KEY=
SMSIR_TEMPLATE_ID=
SMSIR_ORDER_TEMPLATE_ID=
SMSIR_LINE_NUMBER=
# خط تبلیغاتی جدا برای کمپین‌ها (خالی = خط خدماتی)
SMSIR_MARKETING_LINE_NUMBER=
# رمز وب‌هوک پیامک دریافتی (لغو۱۱): https://<site>/api/sms/inbound?key=...
SMS_INBOUND_SECRET=
KAVENEGAR_API_KEY=
KAVENEGAR_OTP_TEMPLATE=verify
KAVENEGAR_SENDER=
FARAZSMS_API_KEY=
FARAZSMS_ORIGINATOR=
FARAZSMS_PATTERN_CODE=

# ---------- Telegram bot (notifications) ----------
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Default chat id of the team group (rules with audience «گروه تلگرام»)
TELEGRAM_ADMIN_CHAT_ID=
# Random string; pass it as secret_token when calling setWebhook
TELEGRAM_WEBHOOK_SECRET=

# ---------- Email (SMTP) ----------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="اسپیرولینا مایا <no-reply@example.com>"

# ---------- Payments ----------
# "production" | "sandbox" (Zarinpal) | "mock" (built-in test gateway).
# mock is refused in production unless ALLOW_MOCK_PAYMENTS=true.
PAYMENT_GATEWAY_MODE="mock"
ALLOW_MOCK_PAYMENTS=false
ZARINPAL_MERCHANT_ID=
# Optional; defaults to NEXT_PUBLIC_APP_URL + /api/payments/zarinpal/callback
ZARINPAL_CALLBACK_URL=

# ---------- Scheduled jobs ----------
# Call GET /api/cron with "Authorization: Bearer $CRON_SECRET" every 10–15 minutes.
CRON_SECRET=

# Business rules (shipping fees, commission %, points…) are no longer env
# variables: the super admin edits them in Portal › تنظیمات و اعلان‌ها.

# ---------- Demo deployment ----------
# true only on a public demo link: login page shows one-click role sign-in and
# the OTP code on screen. Never set this on the real site.
NEXT_PUBLIC_DEMO_MODE=false
